# ==========================================
# Git Ignore Rules for Amazon ML Challenge
# ==========================================

# ------------------------------------------
# Datasets and Large Data Files
# ------------------------------------------
student_resource/dataset/
dataset/
*.tsv
!student_resource/output/*.tsv

# ------------------------------------------
# Python Caches & Bytecode
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------
# Jupyter Notebook Checkpoints & Logs
# ------------------------------------------
.ipynb_checkpoints/
*.log

# ------------------------------------------
# IDE & System Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------------------------
# Model Checkpoints & Pickle Files (EXPLICITLY INCLUDED)
# ------------------------------------------
# Do NOT ignore model pickle files so they are uploaded to GitHub as requested
!*.pkl
!student_resource/model/
!student_resource/model/*.pkl
